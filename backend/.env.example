# Port for the backend server
PORT=5000

# Optional: External PostgreSQL connection string
# Examples:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/minigoogle
#   DATABASE_URL=postgresql://user:pass@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
# If left empty or omitted, Mini Google automatically uses persistent embedded PostgreSQL (PGlite) in backend/data/postgres
# DATABASE_URL=
